#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>

#define N 8 // buffer size

int buffer[N];
int in = 0, out = 0;

// Semaphores
sem_t empty; // counts empty slots
sem_t full;  // counts filled slots
pthread_mutex_t S; // mutex

// Function to produce item
int produce_item() {
    static int item = 1;
    return item++;
}

// Function to consume item
void consume_item(int item) {
    printf("Consumed: %d\n", item);
}

// Producer
void* producer(void* arg) {

    int itemP;

    while (1) {

        itemP = produce_item();

        sem_wait(&empty); // wait(empty)

        pthread_mutex_lock(&S); // lock mutex

        buffer[in] = itemP;

        printf("Produced: %d at position %d\n", itemP, in);

        in = (in + 1) % N;

        pthread_mutex_unlock(&S); // unlock mutex

        sem_post(&full); // signal(full)

        sleep(1);
    }
}

// Consumer
void* consumer(void* arg) {

    int itemC;

    while (1) {

        sem_wait(&full); // wait(full)

        pthread_mutex_lock(&S); // lock mutex

        itemC = buffer[out];

        printf("Consumed: %d from position %d\n", itemC, out);

        out = (out + 1) % N;

        pthread_mutex_unlock(&S); // unlock mutex

        sem_post(&empty); // signal(empty)

        consume_item(itemC);

        sleep(2);
    }
}

int main() {

    pthread_t prod, cons;

    // Initialize semaphores
    sem_init(&empty, 0, N);
    sem_init(&full, 0, 0);

    pthread_mutex_init(&S, NULL);

    // Create threads
    pthread_create(&prod, NULL, producer, NULL);
    pthread_create(&cons, NULL, consumer, NULL);

    // Wait for threads
    pthread_join(prod, NULL);
    pthread_join(cons, NULL);

    // Destroy semaphores
    sem_destroy(&empty);
    sem_destroy(&full);

    pthread_mutex_destroy(&S);

    return 0;
}
